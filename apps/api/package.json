{
  "name": "@reset/api",
  "version": "0.1.0",
  "private": true,
  "description": "RESET backend — NestJS + PostgreSQL + Redis",
  "scripts": {
    "//dev": "NestJS DI resolves constructor params from `design:paramtypes` metadata. esbuild-based runners (tsx, esbuild-register) do not emit it, and Nest treats the absence as 'no dependencies' rather than an error — so the app boots, maps every route, and every injected service is undefined. Always compile this app with tsc or SWC.",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file=.env dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "openapi:export": "nest build && node ./scripts/export-openapi.mjs",
    "clean": "rimraf dist .turbo",
    "lint": "echo \"lint: configured in a later phase\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.1.0",
    "@reset/slot-engine-core": "workspace:*",
    "@reset/types": "workspace:*",
    "ioredis": "^6.0.0",
    "luxon": "^3.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
