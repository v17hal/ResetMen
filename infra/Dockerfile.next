# syntax=docker/dockerfile:1.7

# One Dockerfile for both Next surfaces.
#
#   docker build -f infra/Dockerfile.next --build-arg APP=web   --build-arg PORT=3000 .
#   docker build -f infra/Dockerfile.next --build-arg APP=admin --build-arg PORT=3001 .
#
# They differ only in which workspace is built and which port is served, and two files that
# drift apart is a worse outcome than one with an argument.

ARG APP=web
ARG PORT=3000

# ── Dependencies ───────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
ARG APP
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.18.1 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/types/package.json ./packages/types/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/ui/package.json ./packages/ui/
COPY packages/config/package.json ./packages/config/
COPY apps/${APP}/package.json ./apps/${APP}/

RUN pnpm install --frozen-lockfile --filter @reset/${APP}...

# ── Build ──────────────────────────────────────────────────────────────────────
FROM deps AS build
ARG APP
WORKDIR /app

# Inlined into the client bundle at build time, so it cannot be changed at deploy. A
# different environment means a different image, which is the honest tradeoff for shipping
# the origin in the JavaScript.
ARG NEXT_PUBLIC_API_URL=https://api.reset.app
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1

# Firebase, for customer sign-in. Inlined at build time like the API origin above.
#
# None of these are secret — they ship in every client that talks to Firebase. The real
# control is the authorised-domain list in the Firebase console and the API key's
# HTTP-referrer restriction in Google Cloud. They are left empty by default so a build that
# forgets them fails loudly at sign-in rather than silently authenticating against the
# wrong project.
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ARG NEXT_PUBLIC_FIREBASE_SENDER_ID=
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY}
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN}
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID}
ENV NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID}
ENV NEXT_PUBLIC_FIREBASE_SENDER_ID=${NEXT_PUBLIC_FIREBASE_SENDER_ID}

COPY tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps/${APP} ./apps/${APP}

RUN pnpm --filter @reset/types build && \
    pnpm --filter @reset/design-tokens build && \
    pnpm --filter @reset/api-client build && \
    pnpm --filter @reset/${APP} build

# ── Runtime ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
ARG APP
ARG PORT
WORKDIR /app

RUN apk add --no-cache tini && \
    addgroup -S nodejs -g 1001 && \
    adduser -S nextjs -u 1001

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${PORT}
ENV HOSTNAME=0.0.0.0
# Promoted from the build ARG so CMD can still see it — an ARG does not survive into the
# running container, and the entrypoint would silently fall back to the wrong app.
ENV APP=${APP}

# `output: 'standalone'` traces exactly the files the server needs and copies them into
# .next/standalone — roughly 100 MB instead of the whole workspace's node_modules.
COPY --from=build --chown=nextjs:nodejs /app/apps/${APP}/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=nextjs:nodejs /app/apps/${APP}/public ./apps/${APP}/public

USER nextjs

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
# The standalone server lands at the workspace-relative path it was built from.
CMD ["sh", "-c", "node apps/${APP:-web}/server.js"]
