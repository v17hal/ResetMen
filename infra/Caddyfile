# Caddy terminates TLS and routes to the three surfaces.
#
# Caddy over nginx for one reason that matters at this scale: certificates are automatic
# and renew themselves. An expired certificate on a Sunday is a shop that cannot take
# bookings, and nobody is watching a cron job on a VPS.

{
	# Where Let's Encrypt sends expiry warnings if renewal ever does fail.
	email {$ACME_EMAIL:ops@reset.app}

	servers {
		# Real client IPs reach the API's rate limiter. Without this every request appears
		# to come from the Docker bridge and one attacker exhausts everybody's quota.
		trusted_proxies static private_ranges
	}
}

# ── Shared hardening ───────────────────────────────────────────────────────────
(security) {
	header {
		# One year, and only once the domain is confirmed working — preload is very hard
		# to undo, so it is deliberately absent.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing here needs a camera, a microphone or a location.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		-Server
	}
}

# ── API ────────────────────────────────────────────────────────────────────────
{$API_DOMAIN} {
	import security

	# The webhook signature is an HMAC over the exact bytes Razorpay sent. Nothing may
	# rewrite or re-encode this path — a changed byte is a rejected signature and a
	# payment stuck in CREATED.
	@webhooks path /api/v1/webhooks/*
	handle @webhooks {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy api:4000 {
			health_uri /api/v1/health/ready
			health_interval 30s
		}
	}

	# Uploaded media is immutable — the key is content-addressed, so a changed image is a
	# new key. A year is safe and takes the images off the origin entirely.
	@media path /api/v1/media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /data/access-api.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# ── Customer web app ───────────────────────────────────────────────────────────
{$WEB_DOMAIN} {
	import security

	header {
		# The customer app loads Razorpay's checkout script and posts to their API. Framing
		# is allowed only for their sheet and for Firebase's auth handler.
		#
		# Firebase Auth needs three of these entries, and without them Google sign-in fails
		# as `auth/internal-error` with nothing in the message to say why:
		#
		#   connect-src  identitytoolkit — every Auth call; securetoken — the refresh
		#   frame-src    the SDK opens a hidden iframe on the project's authDomain, which is
		#                where the OAuth handshake actually happens, not on this origin
		#   script-src   apis.google.com, the gapi loader the popup flow pulls in
		#
		# The Android app has no CSP, which is why sign-in worked there and only there.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://apis.google.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' {$API_ORIGIN} https://*.razorpay.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://*.razorpay.com https://*.firebaseapp.com https://accounts.google.com; font-src 'self' data:; base-uri 'self'; form-action 'self'"
	}

	reverse_proxy web:3000
}

# ── www → the apex ─────────────────────────────────────────────────────────────
#
# The DNS record for www has always existed and Caddy was never told to answer for it, so
# it had no certificate and refused the handshake. On its own that is a bad redirect; with
# the HSTS header above it is a dead shop.
#
# `includeSubDomains` tells every browser that has ever loaded resetmen.in to force HTTPS
# on every subdomain for a year, and a browser will not offer to click through a TLS
# failure on an HSTS host. So anyone who typed the www form — or whose address bar
# completed to it, which is what address bars do — got a hard error with no way past it,
# while the site itself was up and healthy. Nothing on the server could show that: it
# answers the apex perfectly and never sees the request that failed.
#
# A redirect rather than a second copy of the app: one canonical hostname, one set of
# cookies, one origin in Firebase's authorised list.
www.{$WEB_DOMAIN} {
	import security
	redir https://{$WEB_DOMAIN}{uri} permanent
}

# ── Admin panel ────────────────────────────────────────────────────────────────
{$ADMIN_DOMAIN} {
	import security

	header {
		# Stricter than the customer app: no third-party scripts, no framing at all.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' {$API_ORIGIN}; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
	}

	# The panel is a counter tool, not a public site. Uncomment once the shop's fixed IP is
	# known — until then a leaked staff password is the only thing between an attacker and
	# the customer table.
	# @office not remote_ip {$OFFICE_IP}
	# respond @office 403

	reverse_proxy admin:3000
}
