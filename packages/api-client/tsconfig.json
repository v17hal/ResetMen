{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    // DOM is here for `fetch`, `Response`, `AbortSignal` and `localStorage` — this package
    // runs in a browser as often as in Node. Node 22 provides all four globally, so the
    // types are accurate on both.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
