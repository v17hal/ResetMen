# Normalise to LF in the repository. Windows checkouts still get CRLF in the working tree
# where the platform wants it, but the committed bytes are identical on every machine —
# otherwise a Windows commit rewrites every line of every file and the diff is useless.
* text=auto eol=lf

# Shell scripts and Docker files must keep LF even on Windows: CRLF in a shebang line
# produces "bad interpreter: /bin/sh^M" inside a container.
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Windows-only tooling
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diffed, never line-ending-converted
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary

# Lockfiles are generated. Collapse them in diffs and don't let anyone hand-merge one.
pnpm-lock.yaml linguist-generated=true -diff
pubspec.lock linguist-generated=true -diff

# Generated design-token outputs are committed so consumers need no build step, but they
# are not hand-edited — the source is packages/design-tokens/src/tokens.ts.
packages/design-tokens/generated/** linguist-generated=true
