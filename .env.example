# ─── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reset:reset@localhost:5432/reset?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars-long
JWT_REFRESH_SECRET=change-me-too-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CHECKIN_HMAC_SECRET=change-me-checkin-secret-min-32-chars-ok

# ─── Customer sign-in (Firebase) ───────────────────────────────────────────────
# REQUIRED in production. Customers sign in with Google through Firebase; without this the
# API cannot verify anyone's token, so nobody can sign in at all — which is why this is the
# one setting that refuses to boot.
#
# The endpoint verifies a *Firebase* ID token rather than a Google one, so enabling phone or
# email sign-in later is a console change, not a release. See docs/11-scope-changes.md.
FIREBASE_PROJECT_ID=reset-booking-52ee0

# ─── SMS / WhatsApp (optional) ─────────────────────────────────────────────────
# No SMS account today, so these stay blank and SMS is logged rather than sent. Push is the
# live notification channel.
#
# If the client ever registers with MSG91: Indian transactional SMS must match a
# DLT-registered template or the operator drops it silently, which is why these are template
# ids rather than message bodies.
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Email (Resend-compatible HTTP API) ────────────────────────────────────────
# Booking confirmations only. Blank → logged, not sent.
EMAIL_API_KEY=
EMAIL_FROM=RESET <no-reply@reset.app>

# ─── Data retention ────────────────────────────────────────────────────────────
# Days a soft-deleted account is kept before its personal data is anonymised (DPDP Act 2023).
# Bookings survive as financial records; the person attached to them does not.
DATA_RETENTION_DAYS=30

# ─── Push notifications (FCM) ──────────────────────────────────────────────────
# Firebase service-account JSON, either raw or base64-encoded. Base64 survives .env files
# and CI secret stores, which mangle the embedded newlines in the private key.
# Leave blank in development: pushes are logged instead of sent.
FCM_SERVICE_ACCOUNT_JSON=

# ─── Payments ──────────────────────────────────────────────────────────────────
# Off. The store takes money at the counter, so a booking is confirmed the moment it is
# made and there is nothing to capture.
#
# The Razorpay path is kept intact and still tested — turning it back on is this one flag
# plus the client's keys, which become mandatory in production when it is true.
PAYMENTS_ENABLED=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Media ─────────────────────────────────────────────────────────────────────
# Local disk today, behind an object-storage-shaped interface. Moving to R2 or S3 is a
# change to two methods in MediaService, not to every call site.
MEDIA_ROOT=./var/media
MEDIA_PUBLIC_BASE_URL=/api/v1/media

# ─── Object storage (Cloudflare R2 / MinIO locally) — not yet wired ─────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=reset-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/reset-media

# ─── Observability (optional in dev) ───────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
