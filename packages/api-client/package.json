{
  "name": "@reset/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client for the RESET API. Hand-written over @reset/types rather than generated — the contract already exists in TypeScript, so generating it from OpenAPI would be a lossy round-trip.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node ./scripts/generate-dart.mjs",
    "lint": "echo \"lint: configured in a later phase\""
  },
  "dependencies": {
    "@reset/types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
